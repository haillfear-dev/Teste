{
  "manifest_version": 3,
  "name": "Clima & Rotas",
  "version": "2.0.0",
  "description": "Consulte o clima e calcule distâncias entre locais com acesso rápido ao Google Maps.",
  "host_permissions": [
    "https://geocoding-api.open-meteo.com/*",
    "https://api.open-meteo.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clima & Rotas",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
