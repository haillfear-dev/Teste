{
  "manifest_version": 3,
  "name": "Clima",
  "version": "1.0",
  "description": "Extensão simples para consultar o clima de qualquer cidade",
  "permissions": [],
  "host_permissions": [
    "https://geocoding-api.open-meteo.com/*",
    "https://api.open-meteo.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clima"
  },
  "icons": {
    "16": "icons/16.svg",
    "48": "icons/48.svg",
    "128": "icons/128.svg"
  }
}
